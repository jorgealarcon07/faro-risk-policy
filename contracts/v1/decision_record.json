{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "status": {
      "enum": [
        "hold",
        "promote"
      ]
    },
    "active": {
      "enum": [
        "logistic",
        "boost"
      ]
    },
    "checks": {
      "type": "object",
      "properties": {
        "validation_eligible": {
          "type": "boolean"
        },
        "higher_ap": {
          "type": "boolean"
        },
        "ap_lower_bound_positive": {
          "type": "boolean"
        },
        "brier_no_worse": {
          "type": "boolean"
        }
      },
      "required": [
        "validation_eligible",
        "higher_ap",
        "ap_lower_bound_positive",
        "brier_no_worse"
      ],
      "additionalProperties": false
    },
    "review_role": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "as_of": {
      "type": "string",
      "format": "date"
    },
    "reason": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "capacity_pct": {
      "const": 5
    },
    "delta_ap_ci95": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number"
      }
    },
    "scenario_assumptions": {
      "type": "object"
    },
    "evidence": {
      "type": "object",
      "required": [
        "selection_frozen.json",
        "policy_report.json",
        "manifest.json"
      ],
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "accounts": {
      "type": "integer",
      "minimum": 0
    },
    "positives": {
      "type": "integer",
      "minimum": 0
    },
    "hits_at_capacity": {
      "type": "integer",
      "minimum": 0
    },
    "review_slots": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "status",
    "active",
    "checks",
    "review_role",
    "run_id",
    "as_of",
    "reason",
    "capacity_pct",
    "delta_ap_ci95",
    "scenario_assumptions",
    "evidence",
    "accounts",
    "positives",
    "hits_at_capacity",
    "review_slots"
  ],
  "additionalProperties": false
}
